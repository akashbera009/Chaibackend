      "fontSize": 10.484321301777854,
      "fontFamily": 8,
      "text": "const uplaodSchema= new mongoose.Schema({\n    filePath:{\n        type:String ,\n    },\n    owner:{\n        type: String ,\n    }\n})",
      "textAlign": "left",
