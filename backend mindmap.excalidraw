      "updated": 1750873985224,
      "link": null,
      "locked": false,
      "text": "const jwt= require('jsonwebtoken')\n\nconst authincate= async(req,res, next)=> {\n    const Token = req.headers['authorization']?.split(' ')[1] \n    if(!Token){\n        return res.status(400).json({message:'Bad Authorization'})\n    }\n    try {\n        const decodedToken = await jwt.verify(Token, process.env.ACCESS_TOKEN_SECRET)\n\n        if(decodedToken){\n        req.user = decodedToken\n          next()\n        }\n    } catch (error) {\n        return res.status(401).json({message:'Authorization failed  !', error:error.message})\n    }\n  \n}\nmodule.exports = {authincate}",
      "fontSize": 17.820237736468034,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const jwt= require('jsonwebtoken')\n\nconst authincate= async(req,res, next)=> {\n    const Token = req.headers['authorization']?.split(' ')[1] \n    if(!Token){\n        return res.status(400).json({message:'Bad Authorization'})\n    }\n    try {\n        const decodedToken = await jwt.verify(Token, process.env.ACCESS_TOKEN_SECRET)\n\n        if(decodedToken){\n        req.user = decodedToken\n          next()\n        }\n    } catch (error) {\n        return res.status(401).json({message:'Authorization failed  !', error:error.message})\n    }\n  \n}\nmodule.exports = {authincate}",
      "autoResize": true,
      "lineHeight": 1.25
    },
