    {
      "type": "text",
      "version": 356,
      "versionNonce": 1901905796,
      "index": "b44",
      "isDeleted": false,
      "id": "5hnT6C8Vy5G8GeJwxaQVD",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "angle": 0,
      "x": 22137.37777247866,
      "y": 2333.1635492072596,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "width": 759.7113647460938,
      "height": 540,
      "seed": 1917338713,
      "groupIds": [],
