      "updated": 1750873985224,
      "link": null,
      "locked": false,
      "text": "userSchema.pre('save', async function (next) {\n    if (!this.isModified('password')) return next();\n    const salt = await bcrypt.genSalt(10); // Adjust the salt rounds as\nneeded\n    this.password = await bcrypt.hash(this.password, salt);\n    next();\n  });\n  \n  // Method to compare passwords\n  userSchema.methods.comparePassword = async function (password) {\n    return await bcrypt.compare(password, this.password);\n  };",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "userSchema.pre('save', async function (next) {\n    if (!this.isModified('password')) return next();\n    const salt = await bcrypt.genSalt(10); // Adjust the salt rounds as needed\n    this.password = await bcrypt.hash(this.password, salt);\n    next();\n  });\n  \n  // Method to compare passwords\n  userSchema.methods.comparePassword = async function (password) {\n    return await bcrypt.compare(password, this.password);\n  };",
      "autoResize": false,
      "lineHeight": 1.25
    },
