      "link": null,
      "locked": false,
      "text": "const fetchImages = async () => {\n    const token = localStorage.getItem('token'); \n    try {\n        const response = await axios.get(`/api/images/${owner}`, {\n            headers: {\n                Authorization: `Bearer ${token}`,\n            },\n        });\n        setImages(response.data);\n    } catch (error) {\n        console.error('Error fetching images:', error);\n    }\n};",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const fetchImages = async () => {\n    const token = localStorage.getItem('token'); \n    try {\n        const response = await axios.get(`/api/images/${owner}`, {\n            headers: {\n                Authorization: `Bearer ${token}`,\n            },\n        });\n        setImages(response.data);\n    } catch (error) {\n        console.error('Error fetching images:', error);\n    }\n};",
      "autoResize": true,
