      "isDeleted": false,
      "boundElements": [],
      "updated": 1750873985224,
      "link": null,
      "locked": false,
      "text": "const viewUserImages = async (req, res) => {\n    const { owner } = req.body;\n    try {\n        const images = await UploadImage.find({ owner }); \n        // console.log(images);\n        \n        res.status(200).json(images); // Return the images as JSON response\n    } catch (error) {\n        console.error(\"Error fetching images:\", error);\n        res.status(500).json({ message: \"Error fetching images\", error });\n    }\n};",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const viewUserImages = async (req, res) => {\n    const { owner } = req.body;\n    try {\n        const images = await UploadImage.find({ owner }); \n        // console.log(images);\n        \n        res.status(200).json(images); // Return the images as JSON response\n    } catch (error) {\n        console.error(\"Error fetching images:\", error);\n        res.status(500).json({ message: \"Error fetching images\", error });\n    }\n};",
      "autoResize": false,
      "lineHeight": 1.25
    },
