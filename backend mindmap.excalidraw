    {
      "type": "text",
      "version": 408,
      "versionNonce": 312846524,
      "index": "b4V",
      "isDeleted": false,
      "id": "jNSNMnIniV7th4RZijTVm",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "angle": 0,
      "x": 20848.026227032908,
      "y": 4024.0124351233494,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "width": 692.090576171875,
      "height": 352.44427390495696,
      "seed": 467104249,
      "groupIds": [],
      "frameId": null,
